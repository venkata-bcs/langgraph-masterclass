# Secrets (settings.config normally lives outside this repo, one level up,
# but this rule is a defensive backstop in case a copy ever lands here)
**/settings.config

# Python
__pycache__/
*.pyc
.venv/
venv/

# Runtime data and state (regenerated by the pipelines, not source)
source-data/*
!source-data/.gitkeep
target-data/*
!target-data/.gitkeep
state/*
!state/.gitkeep
